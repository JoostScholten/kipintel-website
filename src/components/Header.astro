---
import type { SiteContent } from '../content/types';
import { flagIcons } from '../content/icons';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
const h = t.header;
const base = t.assetBase;
---

<header class="header" id="header">
  <div class="container header__inner">
    <a href="#home" class="header__logo" aria-label={h.logoAriaLabel}>
      <img src={`${base}assets/images/logo-no-background.png`} alt="" class="header__logo-img" width="500" height="240">
    </a>
    <nav class="nav" aria-label={h.navAriaLabel}>
      {h.navLinks.map((link) => (
        <a href={link.href} class="nav__link">{link.label}</a>
      ))}
    </nav>
    <div class="header__actions">
      <a href={h.langToggle.href} class="lang-toggle" title={h.langToggle.title}>
        <Fragment set:html={flagIcons[h.langToggle.flag]} />
        <span class="lang-toggle__label">{h.langToggle.label}</span>
      </a>
      <button class="hamburger" id="hamburger" aria-label={h.hamburgerAriaLabel} aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

---
import type { SiteContent } from '../content/types';
import Picture from './Picture.astro';
import { linkedinIcon } from '../content/icons';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
const team = t.team;
---

<section class="section" id="team">
  <div class="container">
    <div class="section__header">
      <span class="section__label">{team.label}</span>
      <h2 class="section__title">{team.title}</h2>
      <p class="section__desc">{team.desc}</p>
    </div>
    <div class="team-grid">
      {team.members.map((member) => (
        <div class="team-card">
          <Picture img={member.img} base={t.assetBase} class="team-card__photo" />
          <div class="team-card__body">
            <p class="team-card__name">{member.name}</p>
            <p class="team-card__role">{member.role}</p>
            <a href={member.linkedin} class="team-card__linkedin" target="_blank" rel="noopener noreferrer">
              <Fragment set:html={linkedinIcon(14)} />
              LinkedIn
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
